{
  "name": "convex-auth-react",
  "version": "0.1.0-alpha.0",
  "description": "Public React UI and hooks for convex-auth.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/shlomokabareti/convex-better-auth-2.0.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsup src/index.ts --format esm --dts --dts-resolve --clean --out-dir dist --external convex-auth-ui",
    "test": "vitest run"
  },
  "dependencies": {
    "convex-auth-ui": "workspace:*",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@convex-dev/better-auth": "0.12.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "convex": "^1.45.0",
    "convex-better-auth": "workspace:*",
    "react": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@convex-dev/better-auth": ">=0.12.5",
    "convex": ">=1.39.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  }
}
