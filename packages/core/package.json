{
  "name": "convex-auth-core",
  "version": "0.1.0-alpha.0",
  "description": "Auth domain core: principals, permissions, identities, and scope registries.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
