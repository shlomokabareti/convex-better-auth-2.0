{
  "name": "convex-better-auth",
  "version": "2.0.0-alpha.0",
  "description": "A public Better Auth runtime for Convex.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/shlomokabareti/convex-better-auth-2.0.git",
    "directory": "packages/better-auth"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./convex": {
      "types": "./dist/convex.d.ts",
      "import": "./dist/convex.js",
      "default": "./dist/convex.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts src/client.ts src/server.ts src/convex.ts --format esm --dts --clean --out-dir dist"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.5",
    "better-auth": ">=1.6.11 <1.7.0",
    "convex-auth-core": "workspace:*",
    "jose": "^6.2.2"
  },
  "peerDependencies": {
    "convex": "^1.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "convex": "^1.45.0",
    "tsup": "^8.5.0",
    "typescript": "^5.5.0"
  }
}
