# Convex deployment URL (used by ConvexHttpClient)
CONVEX_URL=https://your-deployment.convex.cloud

# Convex HTTP actions site URL (used to build OAuth callback URLs)
CONVEX_SITE_URL=https://your-deployment.convex.site

# Deployment slug used by `pnpm dlx convex dev`
# CONVEX_DEPLOYMENT=dev:your-deployment

# OAuth provider credentials (set on your Convex deployment with `pnpm dlx convex env set`)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
